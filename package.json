{
  "name": "wp-autoplugin",
  "version": "1.4.3",
  "description": "A WordPress plugin that generates other plugins on-demand using AI",
  "main": "index.js",
  "scripts": {
    "dev": "webpack --mode development --watch",
    "build": "webpack --mode production",
    "lint": "eslint assets/src/js/**/*.js",
    "lint:fix": "eslint assets/src/js/**/*.js --fix",
    "format": "prettier --write \"assets/src/**/*.{js,jsx,css,scss}\"",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "keywords": [
    "wordpress",
    "plugin",
    "ai",
    "generator"
  ],
  "author": "Balázs Piller",
  "license": "GPL-2.0+",
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@babel/preset-react": "^7.22.0",
    "@wordpress/eslint-plugin": "^17.0.0",
    "autoprefixer": "^10.4.16",
    "babel-loader": "^9.1.3",
    "css-loader": "^6.8.1",
    "css-minimizer-webpack-plugin": "^5.0.1",
    "eslint": "^8.50.0",
    "jest": "^29.7.0",
    "mini-css-extract-plugin": "^2.7.6",
    "postcss": "^8.4.31",
    "postcss-loader": "^7.3.3",
    "prettier": "^3.0.3",
    "sass": "^1.69.0",
    "sass-loader": "^13.3.2",
    "style-loader": "^3.3.3",
    "terser-webpack-plugin": "^5.3.9",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "@wordpress/components": "^25.0.0",
    "@wordpress/element": "^5.20.0",
    "@wordpress/i18n": "^4.44.0",
    "animate.css": "^4.1.1",
    "chart.js": "^4.4.0",
    "codemirror": "^6.0.1",
    "framer-motion": "^10.16.0",
    "notyf": "^3.10.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.4.1"
  }
}